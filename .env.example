# Environment Configuration for CareerEvidence
NODE_ENV=development

PORT=5000

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/careerevidence?schema=public

# Authentication
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d

# Frontend CORS
FRONTEND_URL=http://localhost:5173

# Job Data Provider & Market Scope
JOB_PROVIDER=adzuna
JOB_PROVIDER_COUNTRY=india

# Operation Mode: 'live' (uses real API provider) or 'test' (uses test fixture provider)
JOB_DATA_MODE=test

# Adzuna API credentials (required if JOB_DATA_MODE=live and JOB_PROVIDER=adzuna)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble API key (required if JOB_DATA_MODE=live and JOB_PROVIDER=jooble)
JOOBLE_API_KEY=

# AI / NLP Provider for skill extraction and ambiguous classification
AI_PROVIDER=gemini
AI_API_KEY=

# Automated Collection Scheduler
JOB_COLLECTION_ENABLED=true
JOB_COLLECTION_INTERVAL_HOURS=24

# API Pagination & Throttling
JOB_RESULTS_PER_QUERY=50
JOB_MAX_PAGES_PER_QUERY=5

# Minimum sample size threshold for reliable market signals
MIN_MARKET_SAMPLE_SIZE=15

# Freshness window in days (jobs older than this without updates become STALE)
JOB_FRESHNESS_DAYS=30
